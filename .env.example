# Скопіюй цей файл у .env і заповни ключі, коли отримаєш їх.
# Поки ключа немає — залиш порожнім, відповідний модуль працюватиме в mock-режимі.

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Image generation, основний (безкоштовний ліміт, rate-limited) —
# Gemini 2.5 Flash Image "nano banana". Ключ: aistudio.google.com
GEMINI_API_KEY=

# Image generation, платний fallback, коли квота Gemini вичерпається
# (~$0.003/зображення). Реєстрація: fal.ai
FAL_API_KEY=

# Pinterest API v5 (developers.pinterest.com)
# Після апруву апки пройди OAuth і встав сюди access token
PINTEREST_ACCESS_TOKEN=

# Pinterest OAuth app credentials (потрібні лише для отримання/оновлення токена)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Має ТОЧНО збігатися з Redirect URI, зареєстрованим у Pinterest Developer App.
# Якщо запускаєш веб-панель на іншому порту — онови і тут, і в налаштуваннях апки.
PINTEREST_REDIRECT_URI=http://localhost:8000/api/pinterest/callback
